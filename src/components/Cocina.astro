---
import Icon from './Icon.astro';

const { links, inicio } = Astro.locals.content!;
const valores: string[] = inicio.valores ?? [];
---

<section class="cocina" id="carta" data-cocina aria-labelledby="cocina-title">
  <div class="cocina__marquee" aria-hidden="true">
    <div class="cocina__track" data-marquee>
      {
        [0, 1].map(() => (
          <span>
            {valores.map((v) => (
              <>
                {v}
                <i />
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="wrap cocina__grid">
    <div class="cocina__plate">
      <img
        src="/img/pastel.webp"
        alt="Pastel de choclo gratinado en paila de greda sobre plato blanco"
        width="900"
        height="765"
        loading="lazy"
        decoding="async"
        data-spin
      />
    </div>

    <div class="cocina__text">
      <span class="eyebrow" data-reveal>La carta</span>
      <h2 id="cocina-title" data-reveal style="--d:80ms">{inicio.cocina_titulo}</h2>
      {inicio.cocina_texto && <p data-reveal style="--d:160ms">{inicio.cocina_texto}</p>}
      {
        inicio.cocina_cita && (
          <p class="cocina__quote" data-reveal style="--d:240ms">
            {inicio.cocina_cita}
          </p>
        )
      }
      <div data-reveal style="--d:320ms">
        <a class="btn btn--primary" href={links.carta}>
          Revisa nuestra carta
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cocina {
    position: relative;
    padding-block: var(--s-800) var(--s-900);
    background: var(--cafe);
    overflow: hidden;
  }
  .cocina__marquee {
    overflow: hidden;
    padding-block: var(--s-300);
    border-block: 1px solid rgba(240, 231, 215, 0.18);
  }
  .cocina__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .cocina__track span {
    display: flex;
    align-items: center;
    gap: var(--s-500);
    padding-right: var(--s-500);
    font-size: 3rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: rgba(240, 231, 215, 0.9);
  }
  .cocina__track i {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
    background: var(--terracota);
  }

  .cocina__grid {
    display: grid;
    gap: var(--s-600);
    align-items: center;
    margin-top: var(--s-700);
  }
  .cocina__plate {
    position: relative;
    display: grid;
    place-items: center;
  }
  .cocina__plate::before {
    content: '';
    position: absolute;
    width: 80%;
    aspect-ratio: 1;
    border-radius: var(--r-full);
    background: radial-gradient(closest-side, rgba(244, 123, 68, 0.45), transparent);
    filter: blur(20px);
  }
  .cocina__plate img {
    position: relative;
    width: min(100%, 520px);
    height: auto;
    filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.45));
    will-change: transform;
  }
  .cocina__text > * + * {
    margin-top: var(--s-300);
  }
  .cocina__text h2 {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .cocina__text p {
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: rgba(240, 231, 215, 0.82);
    max-width: 48ch;
  }
  .cocina__text .eyebrow {
    color: #ffb48f;
  }
  .cocina__quote {
    padding: var(--s-300);
    border-radius: var(--r-2xl);
    background: rgba(19, 18, 9, 0.25);
    box-shadow: inset 0 0 0 1px rgba(240, 231, 215, 0.14);
    font-weight: 500;
    color: var(--ink) !important;
  }

  @media (min-width: 900px) {
    .cocina__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: var(--s-800);
    }
    .cocina__text h2 {
      font-size: 3rem;
      line-height: 1;
    }
    .cocina__track span {
      font-size: 6rem;
    }
  }
</style>
