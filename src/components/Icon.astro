---
type Props = { name: string; size?: number; class?: string };
const { name, size = 20, class: className } = Astro.props;
const icons = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!raw) throw new Error(`Icono desconocido: ${name}`);
const svg = raw.replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---

<span class:list={['icon', className]} set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    flex: none;
  }
</style>
