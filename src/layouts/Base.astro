---
import '../styles/global.css';
import { settingsSeed } from '../lib/seed';
import Aviso from '../components/Aviso.astro';
import Live from '../components/Live.astro';

type Props = { title?: string; description?: string };
// En páginas estáticas (404) no hay contenido cargado: se usan los datos iniciales
const g = (Astro.locals.content?.general ?? settingsSeed.general) as Record<string, any>;
const sitio = (Astro.locals.content?.sitio ?? settingsSeed.sitio) as Record<string, any>;

// Título y descripción: lo que se configuró para esta página en el panel, si no, el de la página, si no, el general
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const propia = ((sitio.paginas ?? []) as { ruta: string; titulo?: string; descripcion?: string }[]).find((p) => p.ruta === ruta);
const title = propia?.titulo || Astro.props.title || sitio.seo_titulo;
const description = propia?.descripcion || Astro.props.description || sitio.seo_descripcion;

const origin = sitio.url_sitio ? new URL(sitio.url_sitio).origin : Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const og = new URL(sitio.og_imagen?.src ?? '/img/og.jpg', origin);
const tel = '+' + String(g.whatsapp ?? '').replace(/\D/g, '');
// JSON dentro de <script>: se escapan los caracteres que podrían cerrar la etiqueta
const jsonLd = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!sitio.indexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#131209" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/img/casona-noche.webp" fetchpriority="high" />

    <script
      type="application/ld+json"
      set:html={jsonLd({
        '@context': 'https://schema.org',
        '@type': 'Restaurant',
        name: 'Casa Olivo Restaurante',
        servesCuisine: 'Chilena',
        image: og.href,
        url: `${origin}/`,
        telephone: tel,
        address: {
          '@type': 'PostalAddress',
          streetAddress: [g.direccion, g.lugar].filter(Boolean).join(', '),
          addressLocality: 'Olivar',
          addressRegion: "Libertador General Bernardo O'Higgins",
          addressCountry: 'CL',
        },
        openingHoursSpecification: [
          { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '12:30', closes: '23:00' },
          { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:30', closes: '18:00' },
        ],
        acceptsReservations: g.tableo,
        sameAs: [`https://www.instagram.com/${String(g.instagram).replace(/^@/, '')}`],
      })}
    />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
    <Aviso sitio={sitio} />
    {Astro.locals.content && <Live version={Astro.locals.content.version} />}
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
