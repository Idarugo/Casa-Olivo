---
import AuthShell from '../../components/admin/AuthShell.astro';
import Icon from '../../components/Icon.astro';
import { countUsers, createUser, startSession, validatePassword, checkSetupKey, setupKeyRequired } from '../../lib/auth';

// Solo existe mientras no haya ningún usuario
if ((await countUsers()) > 0) return Astro.redirect('/admin/login');

const needsKey = setupKeyRequired();
const keyConfigured = !needsKey || !!(process.env.SETUP_KEY ?? import.meta.env.SETUP_KEY);
let error = '';
const values = { name: '', email: '' };

if (Astro.request.method === 'POST' && keyConfigured) {
  const form = await Astro.request.formData();
  values.name = String(form.get('name') ?? '').trim();
  values.email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  if (!checkSetupKey(String(form.get('key') ?? ''))) error = 'La clave de instalación no coincide con SETUP_KEY.';
  else if (!values.name) error = 'Escribe tu nombre.';
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) error = 'Escribe un correo válido.';
  else error = validatePassword(password) ?? '';
  if (!error) {
    const user = await createUser(values.email, values.name, password);
    await startSession(Astro.cookies, user.id);
    return Astro.redirect('/admin?ok=bienvenida');
  }
}
---

<AuthShell title="Crear administrador">
  <h1>Crea tu cuenta</h1>
  <p>Este es el primer ingreso al panel. La cuenta que crees aquí podrá invitar a más personas después.</p>
  {
    !keyConfigured && (
      <div class="auth__alert" role="alert">
        <Icon name="warning-circle" size={18} />
        Falta la variable SETUP_KEY en Vercel. Agrégala en Settings → Environment Variables, vuelve a desplegar y recarga esta página.
      </div>
    )
  }
  {
    error && (
      <div class="auth__alert" role="alert">
        <Icon name="warning-circle" size={18} /> {error}
      </div>
    )
  }
  {
    keyConfigured && (
      <form class="auth__form" method="post">
        {needsKey && (
          <div class="field">
            <label class="field__label" for="key">Clave de instalación</label>
            <input class="input" id="key" name="key" type="password" autocomplete="off" required />
            <p class="field__help">El valor que guardaste como SETUP_KEY en Vercel.</p>
          </div>
        )}
        <div class="field">
          <label class="field__label" for="name">Tu nombre</label>
          <input class="input" id="name" name="name" autocomplete="name" required value={values.name} />
        </div>
        <div class="field">
          <label class="field__label" for="email">Correo</label>
          <input class="input" id="email" name="email" type="email" autocomplete="username" required value={values.email} />
        </div>
        <div class="field">
          <label class="field__label" for="password">Contraseña</label>
          <div class="pw">
            <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required />
            <button type="button" data-reveal-pw aria-pressed="false">
              Mostrar
            </button>
          </div>
          <p class="field__help">Al menos 10 caracteres.</p>
        </div>
        <button class="btn btn--primary" type="submit">
          Crear cuenta y entrar
          <Icon name="arrow-right" size={18} />
        </button>
      </form>
    )
  }
</AuthShell>
