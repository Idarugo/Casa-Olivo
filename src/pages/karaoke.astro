---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { partes, termina } from '../lib/format';

const { karaoke, bases } = Astro.locals.content!;
const iconos = ['ticket', 'users-three', 'clock', 'qr-code'];
const ultimaClasificatoria = karaoke.jornadas.filter((j) => j.tipo === 'Clasificatoria').at(-1) ?? karaoke.jornadas.at(-1);
const cierre = ultimaClasificatoria ? termina(ultimaClasificatoria.fecha) : 0;
const formEmbed = `${karaoke.form}?embedded=true`;
---

<Base
  title="Concurso de karaoke · Casa Olivo"
  description="Segunda edición del Concurso de Karaoke Casa Olivo: tres noches clasificatorias, gran final y $200.000 para el primer lugar. Inscripción gratuita para mayores de 18."
>
  <Nav current="eventos" />

  <main id="contenido">
    <section class="kh" aria-labelledby="k-title">
      <div class="kh__bg" aria-hidden="true">
        <img src="/img/letrero-noche.webp" alt="" fetchpriority="high" data-parallax="0.1" />
      </div>
      <div class="kh__spot" aria-hidden="true"></div>
      <div class="wrap kh__inner">
        <span class="kh__badge" data-reveal>{karaoke.edicion}</span>
        <h1 id="k-title" class="kh__title" data-reveal style="--d:80ms">
          <small>Concurso de</small>
          Karaoke
        </h1>
        <p class="kh__lema" data-reveal style="--d:160ms">{karaoke.lema}</p>
        <div class="kh__ctas" data-reveal style="--d:240ms">
          <a class="btn btn--primary" href="#inscripcion">
            <Icon name="microphone-stage" size={20} />
            Inscríbete gratis
          </a>
          <a class="btn btn--ghost" href="#bases">Leer las bases</a>
        </div>
      </div>
    </section>

    <section class="kd" aria-label="Lo esencial">
      <ul class="wrap kd__grid">
        {
          karaoke.datos.map((d, i) => (
            <li data-reveal style={`--d:${i * 80}ms`}>
              <Icon name={iconos[i % iconos.length]} size={24} />
              <h2>{d.t}</h2>
              <p>{d.d}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cal" aria-labelledby="cal-t" data-cal>
      <div class="wrap cal__inner">
        <div class="cal__head">
          <span class="eyebrow" data-reveal>Calendario</span>
          <h2 id="cal-t" data-reveal style="--d:80ms">Cuatro noches, una sola voz ganadora</h2>
          <p data-reveal style="--d:160ms">
            En cada clasificatoria pasan los tres primeros lugares. Los quince clasificados se enfrentan en la gran final.
          </p>
        </div>
        <ol class="cal__list">
          <span class="cal__line" aria-hidden="true"><span data-cal-fill></span></span>
          {
            karaoke.jornadas.map((j, i) => {
              const f = partes(j.fecha);
              return (
                <li class:list={['cal__item', { 'cal__item--final': j.tipo === 'Gran final' }]} data-jornada={termina(j.fecha)}>
                  <span class="cal__dot" aria-hidden="true" />
                  <div class="cal__date">
                    <strong>{f.dia}</strong>
                    <span>{f.mesCorto}</span>
                  </div>
                  <div class="cal__body">
                    <h3>
                      {j.tipo === 'Gran final' ? 'Gran final' : `Clasificatoria ${i + 1}`}
                      <em class="cal__tag cal__tag--next">Próxima</em>
                      <em class="cal__tag cal__tag--done">Realizada</em>
                    </h3>
                    <p>
                      <span class="cal__wd">{f.semana}</span>, {f.hora} hrs
                    </p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    <section class="prem" aria-labelledby="prem-t">
      <div class="wrap">
        <span class="eyebrow" data-reveal>Premios</span>
        <h2 id="prem-t" data-reveal style="--d:80ms">En efectivo y con trofeo</h2>
        <ol class="prem__podio">
          {
            karaoke.premios.map((p, i) => (
              <li class={`prem__p prem__p--${i + 1}`} data-reveal style={`--d:${[160, 80, 240][i]}ms`}>
                <Icon name="trophy" size={i === 0 ? 40 : 28} />
                <span class="prem__lugar">{p.lugar}</span>
                <span class="prem__monto">
                  $<span data-count={p.monto}>{p.monto.toLocaleString('es-CL')}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="insc" id="inscripcion" data-open-until={cierre} aria-labelledby="insc-t">
      <div class="wrap insc__grid">
        <div class="insc__text">
          <span class="eyebrow" data-reveal>Inscripción</span>
          <h2 id="insc-t" data-reveal style="--d:80ms">Reserva tu cupo para cantar</h2>
          <div data-if-open>
            <p data-reveal style="--d:160ms">Completa el formulario con tus datos y tres opciones de canción. Necesitarás:</p>
            <ul class="insc__need" data-reveal style="--d:200ms">
              <li>Nombre completo, RUT, teléfono y correo.</li>
              <li>Tres canciones de hasta 5 minutos, con el link de YouTube de la versión karaoke.</li>
            </ul>
            <p class="insc__small" data-reveal style="--d:240ms">
              Una vez validada la información, te contactaremos para coordinar los detalles. Esas canciones serán las que cantes en todo
              el concurso, incluida la final.
            </p>
          </div>
          <div data-if-closed hidden>
            <p>Las inscripciones ya cerraron. Te esperamos en la gran final para votar por tu favorito.</p>
          </div>
        </div>

        <div class="ticket" data-if-open data-reveal>
          <div class="ticket__head">
            <span>Ficha de inscripción</span>
            <a href={karaoke.form} target="_blank" rel="noopener">
              Abrir en Google Forms
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
          <iframe src={formEmbed} title="Formulario de inscripción al concurso de karaoke" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <section class="bases" id="bases" aria-labelledby="bases-t">
      <div class="wrap bases__grid">
        <div class="bases__head">
          <span class="eyebrow" data-reveal>Bases oficiales</span>
          <h2 id="bases-t" data-reveal style="--d:80ms">{karaoke.nombre}</h2>
          <p data-reveal style="--d:160ms">2do concurso “{karaoke.lema}”.</p>
        </div>
        <div class="bases__list">
          {
            bases.map((b, i) => (
              <details open={i < 2}>
                <summary>
                  <span class="bases__n">{String(i + 1).padStart(2, '0')}</span>
                  {b.t}
                  <i aria-hidden="true" />
                </summary>
                <div class="bases__body">
                  {b.p?.map((x) => (
                    <p>{x}</p>
                  ))}
                  {b.li && (
                    <ul>
                      {b.li.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  import '../scripts/agenda';
  import '../scripts/scrollfx';

  // La línea del calendario se llena con el scroll
  const cal = document.querySelector<HTMLElement>('[data-cal]')!;
  const fill = cal.querySelector<HTMLElement>('[data-cal-fill]')!;
  const list = cal.querySelector<HTMLElement>('.cal__list')!;
  let ticking = false;
  function frame() {
    ticking = false;
    const r = list.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (window.innerHeight * 0.6 - r.top) / r.height));
    fill.style.transform = `scaleY(${p.toFixed(4)})`;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    },
    { passive: true },
  );
  frame();
</script>

<style>
  /* Portada */
  .kh {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: 140px var(--s-800);
    overflow: hidden;
    isolation: isolate;
  }
  .kh__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .kh__bg img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: 58% 40%;
  }
  .kh__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(19, 18, 9, 0.78);
  }
  /* Foco de escenario sobre el título */
  .kh__spot {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(50% 60% at 30% 70%, rgba(244, 123, 68, 0.28), transparent 70%);
    animation: spot 6s var(--ease) infinite alternate;
  }
  @keyframes spot {
    from {
      transform: translateX(-6%);
    }
    to {
      transform: translateX(6%);
    }
  }
  .kh__inner > * + * {
    margin-top: var(--s-300);
  }
  .kh__badge {
    display: inline-block;
    padding: var(--s-50) var(--s-100);
    border-radius: var(--r-full);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--terracota);
    color: var(--terracota-ink);
    transform: rotate(-3deg);
  }
  .kh__title {
    display: flex;
    flex-direction: column;
    font-size: 6rem;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--terracota);
  }
  .kh__title small {
    font-size: 1.5rem;
    line-height: 2rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .kh__lema {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 500;
  }
  .kh__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-100);
  }
  @media (min-width: 768px) {
    .kh__title {
      font-size: 9rem;
    }
    .kh__title small {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
  }

  /* Datos */
  .kd {
    padding-block: var(--s-700);
    border-block: 1px solid var(--line);
  }
  .kd__grid {
    display: grid;
    gap: var(--s-300);
    margin: 0 auto;
    list-style: none;
  }
  .kd li > .icon {
    color: var(--terracota);
  }
  .kd h2 {
    margin-top: var(--s-100);
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  .kd p {
    color: var(--ink-soft);
  }
  @media (min-width: 768px) {
    .kd__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Calendario */
  .cal {
    padding-block: var(--s-900);
  }
  .cal__inner {
    display: grid;
    gap: var(--s-600);
  }
  .cal__head > * + * {
    margin-top: var(--s-200);
  }
  .cal__head h2 {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .cal__head p {
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--ink-soft);
  }
  .cal__list {
    position: relative;
    display: grid;
    gap: var(--s-400);
    margin: 0;
    padding: 0 0 0 var(--s-500);
    list-style: none;
  }
  .cal__line {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--line);
  }
  .cal__line span {
    display: block;
    height: 100%;
    background: var(--terracota);
    transform-origin: 50% 0;
    transform: scaleY(0);
  }
  .cal__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-300);
  }
  .cal__dot {
    position: absolute;
    left: calc(-1 * var(--s-500));
    top: 50%;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border-radius: var(--r-full);
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--terracota);
  }
  .cal__item.is-done .cal__dot {
    background: var(--terracota);
  }
  .cal__item.is-next .cal__dot {
    background: var(--terracota);
    box-shadow: 0 0 0 6px rgba(244, 123, 68, 0.25);
  }
  .cal__date {
    flex: none;
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: var(--r-2xl);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cal__date strong {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-variant-numeric: tabular-nums;
  }
  .cal__date span {
    margin-top: -6px;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .cal__item--final .cal__date {
    background: var(--terracota);
    color: var(--terracota-ink);
    box-shadow: none;
  }
  .cal__item--final .cal__date span {
    color: var(--terracota-ink);
  }
  .cal__body h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-75);
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  .cal__item--final .cal__body h3 {
    font-size: 1.5rem;
    line-height: 2rem;
    color: var(--terracota);
  }
  .cal__body p {
    color: var(--ink-soft);
  }
  .cal__wd {
    text-transform: capitalize;
  }
  .cal__tag {
    display: none;
    padding: 0 var(--s-75);
    border-radius: var(--r-full);
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-style: normal;
    font-weight: 600;
  }
  .cal__item.is-next .cal__tag--next {
    display: inline-block;
    background: var(--terracota);
    color: var(--terracota-ink);
  }
  .cal__item.is-done .cal__tag--done {
    display: inline-block;
    color: var(--ink-soft);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cal__item.is-done .cal__body h3,
  .cal__item.is-done .cal__date {
    opacity: 0.6;
  }
  @media (min-width: 900px) {
    .cal__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-900);
      align-items: center;
    }
    .cal__head h2 {
      font-size: 3rem;
      line-height: 1;
    }
  }

  /* Premios */
  .prem {
    padding-block: var(--s-900);
    background: var(--bg-2);
  }
  .prem h2 {
    margin-top: var(--s-200);
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .prem__podio {
    display: grid;
    gap: var(--s-200);
    margin: var(--s-600) 0 0;
    padding: 0;
    list-style: none;
  }
  .prem__p {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-75);
    padding: var(--s-400);
    border-radius: var(--r-3xl);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .prem__p .icon {
    color: var(--terracota);
  }
  .prem__lugar {
    font-weight: 600;
    color: var(--ink-soft);
  }
  .prem__monto {
    font-size: 3rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .prem__p--1 {
    background: var(--terracota);
    color: var(--terracota-ink);
    box-shadow: none;
  }
  .prem__p--1 .icon,
  .prem__p--1 .prem__lugar {
    color: var(--terracota-ink);
  }
  @media (min-width: 768px) {
    .prem h2 {
      font-size: 3.75rem;
      line-height: 1;
    }
    .prem__podio {
      grid-template-columns: 1fr 1.15fr 1fr;
      align-items: end;
    }
    /* Orden de podio: 2° · 1° · 3° */
    .prem__p--1 {
      order: 2;
      min-height: 360px;
    }
    .prem__p--2 {
      order: 1;
      min-height: 280px;
    }
    .prem__p--3 {
      order: 3;
      min-height: 220px;
    }
    .prem__p--1 .prem__monto {
      font-size: 4.5rem;
    }
  }

  /* Inscripción */
  .insc {
    padding-block: var(--s-900);
    scroll-margin-top: var(--s-600);
  }
  .insc__grid {
    display: grid;
    gap: var(--s-600);
  }
  .insc__text > * + * {
    margin-top: var(--s-200);
  }
  .insc__text h2 {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .insc__text p {
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--ink-soft);
  }
  .insc__need {
    display: grid;
    gap: var(--s-100);
    margin: var(--s-200) 0;
    padding-left: var(--s-300);
  }
  .insc__need li::marker {
    color: var(--terracota);
  }
  .insc__text .insc__small {
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  /* El formulario de Google es claro: lo presentamos como una ficha de papel */
  .ticket {
    border-radius: var(--r-3xl);
    background: #f0e7d7;
    color: var(--terracota-ink);
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35);
  }
  .ticket[hidden] {
    display: none;
  }
  .ticket__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-100);
    padding: var(--s-200) var(--s-300);
    border-bottom: 2px dashed rgba(26, 15, 8, 0.2);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
  }
  .ticket__head a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-25);
    color: #b5501f;
    text-decoration: none;
  }
  .ticket__head a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ticket iframe {
    display: block;
    width: 100%;
    height: 1500px;
    border: 0;
  }
  @media (min-width: 1024px) {
    .insc__grid {
      grid-template-columns: 1fr 560px;
      gap: var(--s-900);
      align-items: start;
    }
    .insc__text {
      position: sticky;
      top: 120px;
    }
    .insc__text h2 {
      font-size: 3rem;
      line-height: 1;
    }
  }

  /* Bases */
  .bases {
    padding-block: var(--s-900);
    background: var(--bg-2);
    scroll-margin-top: var(--s-600);
  }
  .bases__grid {
    display: grid;
    gap: var(--s-600);
  }
  .bases__head > * + * {
    margin-top: var(--s-200);
  }
  .bases__head h2 {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .bases__head p {
    color: var(--ink-soft);
  }
  .bases__list {
    display: grid;
    gap: var(--s-100);
  }
  .bases details {
    border-radius: var(--r-2xl);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .bases summary {
    display: flex;
    align-items: center;
    gap: var(--s-200);
    padding: var(--s-300);
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .bases summary::-webkit-details-marker {
    display: none;
  }
  .bases__n {
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--terracota);
    font-variant-numeric: tabular-nums;
  }
  .bases summary i {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-left: auto;
  }
  .bases summary i::before,
  .bases summary i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--terracota);
    transition: transform 500ms var(--ease);
  }
  .bases summary i::after {
    transform: rotate(90deg);
  }
  .bases details[open] summary i::after {
    transform: rotate(0deg);
  }
  .bases__body {
    display: grid;
    gap: var(--s-100);
    padding: 0 var(--s-300) var(--s-300);
    color: var(--ink-soft);
  }
  .bases__body ul {
    display: grid;
    gap: var(--s-75);
    margin: 0;
    padding-left: var(--s-300);
  }
  .bases__body li::marker {
    color: var(--terracota);
  }
  @media (min-width: 1024px) {
    .bases__grid {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--s-900);
      align-items: start;
    }
    .bases__head {
      position: sticky;
      top: 120px;
    }
    .bases__head h2 {
      font-size: 3rem;
      line-height: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kh__spot {
      animation: none;
    }
  }
</style>
