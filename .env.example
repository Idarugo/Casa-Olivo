# Copia este archivo como .env solo si quieres usar la base de producción en local.
# Sin estas variables, `npm run dev` usa una base local (PGlite) en .data/ y guarda las fotos en .data/uploads.

# Postgres de Neon. Vercel la crea al conectar la base en Storage.
DATABASE_URL=

# Vercel Blob, para las fotos subidas desde el panel. Vercel la crea al conectar el Blob store.
BLOB_READ_WRITE_TOKEN=

# SETUP_KEY: solo se agrega en Vercel para crear el primer administrador en
# /admin/setup, y se borra después (ver README → Puesta en marcha).
